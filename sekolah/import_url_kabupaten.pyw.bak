def save_kabupaten_to_db(kabupaten_data, url_induk_id, user_id):
    """Simpan data kabupaten ke database"""
    
    success_count = 0
    failed_count = 0
    
    for kab in kabupaten_data:
        try:
            # Cek apakah sudah ada
