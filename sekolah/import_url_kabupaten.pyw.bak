                        if text and len(text) > 2:  # Minimal ada nama
                            kabupaten_list.append({
                                'kode': kode,
                                'nama': text,
                                'url': full_url
                            })
                            logging.info(f"  Found: {text} -> {full_url}")
            
            # Remove duplicates berdasarkan URL
            seen = set()
            unique_list = []
            for kab in kabupaten_list:
                if kab['url'] not in seen:
                    seen.add(kab['url'])
                    unique_list.append(kab)
            
            logging.info(f"✓ Berhasil scraping {len(unique_list)} kabupaten")
            return unique_list
            
        except requests.exceptions.HTTPError as e:
            if '404' in str(e):
                logging.warning(f"⚠ Attempt {attempt + 1} failed: {e}")
                logging.warning(f"⚠ URL mungkin salah atau sudah berubah")
                # Coba attempt berikutnya (mungkin temporary error)
                if attempt < max_retries - 1:
                    time.sleep(2)
                else:
                    logging.error(f"✗ URL tidak valid setelah {max_retries} attempts")
                    return []
            else:
                logging.warning(f"⚠ Attempt {attempt + 1} failed: {e}")
                if attempt < max_retries - 1:
                    time.sleep(2)
                else:
                    return []
        
        except requests.exceptions.RequestException as e:
            logging.warning(f"⚠ Attempt {attempt + 1} failed: {e}")
            if attempt < max_retries - 1:
                time.sleep(2)
            else:
                logging.error(f"✗ Gagal scraping setelah {max_retries} attempts")
                return []
        
        except Exception as e:
            logging.error(f"✗ Error parsing HTML: {e}")
            import traceback
            logging.error(traceback.format_exc())
            return []
    
    return []

