config = configparser.ConfigParser()

try:
    config.read(config_path)
    
    db_config = {
        'host': config.get('database', 'host', fallback='localhost'),
        'port': config.getint('database', 'port', fallback=3306),
        'user': config.get('database', 'user', fallback='root'),
