# ----------------------------------------------------------
# 8. FUNGSI SCRAPING KABUPATEN
# ----------------------------------------------------------
def scrape_kabupaten(url, max_retries=300):
    """Scrape daftar kabupaten dari halaman Dapodik"""
    
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
    }
    
    for attempt in range(max_retries):
        try:
            logging.info(f"Attempt {attempt + 1}/{max_retries}: Fetching {url}")
            
            response = requests.get(url, headers=headers, timeout=30)
            response.raise_for_status()
            
            soup = BeautifulSoup(response.content, 'html.parser')
            
            # DEBUG: Log struktur HTML untuk analisis
            logging.info(f"Response Status: {response.status_code}")
            logging.info(f"Content Length: {len(response.content)}")
            
            kabupaten_list = []
            
            # METODE 1: Cari semua link yang mengandung kata kunci kabupaten/kota
            links = soup.find_all('a', href=True)
            logging.info(f"Total links found: {len(links)}")
            
            for link in links:
                href = link.get('href', '')
                text = link.get_text(strip=True)
                
                # Filter link yang kemungkinan kabupaten
                # Sesuaikan pattern ini dengan struktur URL Dapodik
                if any(keyword in href.lower() for keyword in ['kabupaten', 'kota', '/sp/', '/2/']):
                    # Pastikan bukan link yang sama dengan URL induk
                    if href != url and href != '':
                        # Buat URL lengkap jika relative
                        if not href.startswith('http'):
                            from urllib.parse import urljoin
                            full_url = urljoin(url, href)
                        else:
                            full_url = href
                        
                        # Extract kode dari URL (contoh: /sp/2/150100 -> kode: 150100)
                        import re
                        kode_match = re.search(r'/(\d{6})/?

# ----------------------------------------------------------
# 9. SIMPAN DATA KABUPATEN KE DATABASE
# ----------------------------------------------------------
def save_kabupaten_to_db(kabupaten_data, url_induk_id, user_id):
    """Simpan data kabupaten ke database"""
    
    success_count = 0
    failed_count = 0
    
    for kab in kabupaten_data:
        try:
            # Cek apakah sudah ada
            cursor.execute(
                "SELECT id FROM kabupaten_scrape WHERE url = %s",
                (kab['url'],)
            )
            existing = cursor.fetchone()
            
            if existing:
                # Update jika sudah ada
                cursor.execute("""
                    UPDATE kabupaten_scrape 
                    SET kode_kabupaten = %s, nama_kabupaten = %s, 
                        status = 'active', updated_at = NOW()
                    WHERE id = %s
                """, (kab['kode'], kab['nama'], existing['id']))
                
                logging.info(f"  ↻ Updated: {kab['nama']}")
            else:
                # Insert baru
                cursor.execute("""
                    INSERT INTO kabupaten_scrape 
                    (url_induk_id, kode_kabupaten, nama_kabupaten, url, status, created_at, updated_at)
                    VALUES (%s, %s, %s, %s, 'active', NOW(), NOW())
                """, (url_induk_id, kab['kode'], kab['nama'], kab['url']))
                
                logging.info(f"  ✓ Inserted: {kab['nama']}")
            
            connection.commit()
            success_count += 1
            
        except Exception as e:
            logging.error(f"  ✗ Failed to save {kab['nama']}: {e}")
            failed_count += 1
            connection.rollback()
    
    return success_count, failed_count

# ----------------------------------------------------------
# 10. PROSES UTAMA
# ----------------------------------------------------------
try:
    logging.info("=" * 80)
    logging.info("MEMULAI PROSES SCRAPING KABUPATEN")
    logging.info("=" * 80)
    
    # Scraping kabupaten
    kabupaten_data = scrape_kabupaten(base_url, args.max_retries)
    
    if not kabupaten_data:
        raise Exception("Tidak ada data kabupaten yang berhasil di-scrape")
    
    # Simpan ke database
    success_count, failed_count = save_kabupaten_to_db(
        kabupaten_data, 
        args.url_induk_id, 
        args.user_id
    )
    
    # Update import_log
    cursor.execute("""
        UPDATE import_log 
        SET status = 'completed', 
            total_processed = %s,
            total_success = %s,
            total_failed = %s,
            completed_at = NOW()
        WHERE url_induk_id = %s AND process_type = 'kabupaten'
        ORDER BY started_at DESC LIMIT 1
    """, (len(kabupaten_data), success_count, failed_count, args.url_induk_id))
    
    connection.commit()
    
    logging.info("=" * 80)
    logging.info("PROSES SELESAI")
    logging.info(f"Total Processed: {len(kabupaten_data)}")
    logging.info(f"Success: {success_count}")
    logging.info(f"Failed: {failed_count}")
    logging.info("=" * 80)
    
except Exception as e:
    logging.error(f"✗✗✗ ERROR FATAL: {e}")
    
    # Update import_log dengan status failed
    try:
        cursor.execute("""
            UPDATE import_log 
            SET status = 'failed', 
                error_message = %s,
                completed_at = NOW()
            WHERE url_induk_id = %s AND process_type = 'kabupaten'
            ORDER BY started_at DESC LIMIT 1
        """, (str(e), args.url_induk_id))
        connection.commit()
    except:
        pass
    
    sys.exit(1)

finally:
    # Tutup koneksi
    if 'cursor' in locals():
        cursor.close()
    if 'connection' in locals():
        connection.close()
    
    logging.info("✓ Koneksi database ditutup")
    logging.info(">>> Script selesai <<<")
